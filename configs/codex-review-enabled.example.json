{
  "$schema": "../schemas/graft_config.schema.json",
  "version": 2,
  "method": "graft-original",
  "enabled": true,
  "budget": 4.0,
  "checkpoint_mode": "completion",
  "max_feedback_rounds": 2,
  "failure_policy": "open",
  "environment_fingerprint": "graft-original-dynamic-v1",
  "modeling": {
    "behavior_modeler": {
      "model": null,
      "timeout_s": 120,
      "prompt_family": "graft-original-behavior-v1"
    },
    "verifier_planner": {
      "model": null,
      "timeout_s": 120,
      "prompt_family": "graft-original-verifier-planner-v1"
    }
  },
  "verifier_templates": [
    {
      "id": "repository-evidence-agent",
      "kind": "codex_agent",
      "role": "repository-declared deterministic evidence agent",
      "instructions": "Derive a task-relevant direct-argv command from repository-owned declarations and execute it only in the disposable copy.",
      "capabilities": ["repository-tool-discovery", "deterministic-execution", "runtime-evidence"],
      "cost": 1.25,
      "timeout_s": 180,
      "sandbox": "workspace-write",
      "isolation": "temporary-copy",
      "max_instances": 2,
      "blocking": true,
      "model": null,
      "lineage": {
        "provider": "openai-codex",
        "thread_policy": "fresh-ephemeral-copy",
        "prompt_family": "repository-evidence-agent-v1",
        "context_sources": ["raw-requirements", "workspace-copy", "repository-tool-declarations"],
        "modality": ["text", "source", "execution"],
        "oracle": "repository-declared-command"
      }
    },
    {
      "id": "semantic-reviewer",
      "kind": "codex_review",
      "role": "independent semantic requirements reviewer",
      "instructions": "Inspect raw requirements and observable state; challenge semantic omissions.",
      "capabilities": ["requirements", "source", "diff", "semantic-review"],
      "cost": 1.0,
      "timeout_s": 120,
      "sandbox": "read-only",
      "isolation": "ephemeral",
      "max_instances": 2,
      "blocking": true,
      "model": null,
      "lineage": {
        "provider": "openai-codex",
        "thread_policy": "fresh-ephemeral",
        "prompt_family": "semantic-reviewer-v1",
        "context_sources": ["raw-requirements", "workspace", "diff"],
        "modality": ["text", "source"],
        "oracle": "model-review"
      }
    },
    {
      "id": "agentic-evidence-reviewer",
      "kind": "codex_agent",
      "role": "agentic environment and execution reviewer",
      "instructions": "Use read-only tools to derive task-specific observed evidence.",
      "capabilities": ["repository-search", "tool-execution", "runtime-evidence"],
      "cost": 1.5,
      "timeout_s": 180,
      "sandbox": "read-only",
      "isolation": "ephemeral",
      "max_instances": 2,
      "blocking": true,
      "model": null,
      "lineage": {
        "provider": "openai-codex",
        "thread_policy": "fresh-ephemeral",
        "prompt_family": "agentic-evidence-reviewer-v1",
        "context_sources": ["raw-requirements", "workspace", "runtime"],
        "modality": ["text", "source", "execution"],
        "oracle": "agentic-observation"
      }
    },
    {
      "id": "test-agent",
      "kind": "codex_agent",
      "role": "task-specific adversarial test agent",
      "instructions": "Derive and execute task-specific checks only in the disposable copy.",
      "capabilities": ["test-generation", "tool-execution", "adversarial-cases"],
      "cost": 2.0,
      "timeout_s": 240,
      "sandbox": "workspace-write",
      "isolation": "temporary-copy",
      "max_instances": 1,
      "blocking": true,
      "model": null,
      "lineage": {
        "provider": "openai-codex",
        "thread_policy": "fresh-ephemeral-copy",
        "prompt_family": "test-agent-v1",
        "context_sources": ["raw-requirements", "workspace-copy", "generated-tests"],
        "modality": ["text", "source", "execution"],
        "oracle": "generated-executable-check",
        "test_author": "independent-codex-test-agent"
      }
    }
  ],
  "selection": {
    "algorithm": "lazy-greedy-hypergraph",
    "max_verifiers": 4,
    "min_marginal_gain_per_cost": 0.01,
    "residual_risk_threshold": 0.2
  },
  "_method_contract": "docs/method-original-frozen.md"
}
