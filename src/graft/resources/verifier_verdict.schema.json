{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRAFT verifier verdict",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "abstain", "error"]
    },
    "failure_modes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "command": {
            "type": "array",
            "items": {"type": "string"}
          },
          "observation": {"type": "string"}
        },
        "required": ["kind", "path", "line", "command", "observation"],
        "additionalProperties": false
      }
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
  },
  "required": ["verdict", "failure_modes", "summary", "evidence", "confidence"],
  "additionalProperties": false
}
