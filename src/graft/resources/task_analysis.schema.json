{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRAFT task analysis",
  "type": "object",
  "properties": {
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "observables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "severity": {"type": "number", "minimum": 0, "maximum": 1},
          "likelihood": {"type": "number", "minimum": 0, "maximum": 1},
          "reach": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "required": ["id", "description", "source_refs", "observables", "severity", "likelihood", "reach"],
        "additionalProperties": false
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "behavior_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "observable_signals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "risk": {"type": "number", "minimum": 0, "maximum": 2}
        },
        "required": ["id", "behavior_id", "description", "category", "observable_signals", "required_capabilities", "risk"],
        "additionalProperties": false
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["behaviors", "failure_modes", "uncertainties"],
  "additionalProperties": false
}
