{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRAFT Original configuration v2",
  "type": "object",
  "required": [
    "version",
    "method",
    "enabled",
    "budget",
    "checkpoint_mode",
    "max_feedback_rounds",
    "failure_policy",
    "modeling",
    "verifier_templates",
    "selection"
  ],
  "properties": {
    "version": {"const": 2},
    "method": {"const": "graft-original"},
    "enabled": {"type": "boolean"},
    "budget": {"type": "number", "minimum": 0},
    "checkpoint_mode": {
      "type": "string",
      "enum": ["completion", "strict", "explicit"]
    },
    "max_feedback_rounds": {"type": "integer", "minimum": 0},
    "failure_policy": {"type": "string", "enum": ["open", "closed"]},
    "environment_fingerprint": {"type": "string"},
    "modeling": {
      "type": "object",
      "required": ["behavior_modeler", "verifier_planner"],
      "properties": {
        "behavior_modeler": {"$ref": "#/$defs/modelStage"},
        "verifier_planner": {"$ref": "#/$defs/modelStage"}
      },
      "additionalProperties": false
    },
    "verifier_templates": {
      "type": "array",
      "items": {"$ref": "#/$defs/verifierTemplate"}
    },
    "selection": {
      "type": "object",
      "required": [
        "algorithm",
        "max_verifiers",
        "min_marginal_gain_per_cost",
        "residual_risk_threshold"
      ],
      "properties": {
        "algorithm": {"const": "lazy-greedy-hypergraph"},
        "max_verifiers": {"type": "integer", "minimum": 1},
        "min_marginal_gain_per_cost": {"type": "number", "minimum": 0},
        "residual_risk_threshold": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "_method_contract": {"type": "string"},
    "_note": {"type": "string"}
  },
  "$defs": {
    "modelStage": {
      "type": "object",
      "required": ["model", "timeout_s", "prompt_family"],
      "properties": {
        "model": {"type": ["string", "null"]},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "prompt_family": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": ["string", "null"]},
        "thread_policy": {"type": ["string", "null"]},
        "prompt_family": {"type": ["string", "null"]},
        "context_sources": {"type": "array", "items": {"type": "string"}},
        "modality": {"type": "array", "items": {"type": "string"}},
        "oracle": {"type": ["string", "null"]},
        "test_author": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "verifierTemplate": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "role",
        "instructions",
        "capabilities",
        "cost",
        "timeout_s",
        "sandbox",
        "isolation",
        "max_instances",
        "blocking",
        "model",
        "lineage"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["codex_review", "codex_agent", "command"]},
        "role": {"type": "string", "minLength": 1},
        "instructions": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "cost": {"type": "number", "minimum": 0},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "sandbox": {"type": "string", "enum": ["read-only", "workspace-write"]},
        "isolation": {"type": "string", "enum": ["ephemeral", "temporary-copy"]},
        "max_instances": {"type": "integer", "minimum": 1},
        "blocking": {"type": "boolean"},
        "model": {"type": ["string", "null"]},
        "command": {"type": "array", "items": {"type": "string"}},
        "failure_exit_codes": {"type": "array", "items": {"type": "integer"}},
        "working_directory": {"type": ["string", "null"]},
        "lineage": {"$ref": "#/$defs/lineage"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
