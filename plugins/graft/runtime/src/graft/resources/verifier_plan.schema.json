{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRAFT Original dynamic verifier plan",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "template_id": {"type": "string", "minLength": 1},
          "target_failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "objective": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "estimated_detection": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "failure_mode_id": {"type": "string", "minLength": 1},
                "probability": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "required": ["failure_mode_id", "probability"],
              "additionalProperties": false
            }
          },
          "additional_context_sources": {"type": "array", "items": {"type": "string"}},
          "additional_modalities": {"type": "array", "items": {"type": "string"}},
          "oracle": {"type": ["string", "null"]}
        },
        "required": ["id", "template_id", "target_failure_modes", "objective", "prompt", "estimated_detection", "additional_context_sources", "additional_modalities", "oracle"],
        "additionalProperties": false
      }
    },
    "shared_blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "affected_verifiers": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "residual_detection": {"type": "number", "minimum": 0, "maximum": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "required": ["id", "description", "weight", "affected_verifiers", "failure_modes", "residual_detection", "sources"],
        "additionalProperties": false
      }
    },
    "coverage_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["candidates", "shared_blind_spots", "coverage_gaps"],
  "additionalProperties": false
}
