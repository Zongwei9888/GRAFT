{
  "description": "GRAFT source-bound checkpoint verification for Codex.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$PLUGIN_ROOT/scripts/graft_plugin.py\" hook user-prompt --installation-id graft-plugin-v1",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\graft_plugin.py\" hook user-prompt --installation-id graft-plugin-v1",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$PLUGIN_ROOT/scripts/graft_plugin.py\" hook post-tool --installation-id graft-plugin-v1",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\graft_plugin.py\" hook post-tool --installation-id graft-plugin-v1",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$PLUGIN_ROOT/scripts/graft_plugin.py\" hook stop --installation-id graft-plugin-v1",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\graft_plugin.py\" hook stop --installation-id graft-plugin-v1",
            "timeout": 600,
            "statusMessage": "GRAFT is verifying this checkpoint"
          }
        ]
      }
    ]
  }
}
